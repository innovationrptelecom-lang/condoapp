
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Condominium {
  id          Int       @id @default(autoincrement())
  name        String
  address     String?
  calls       Call[]
  periodic    PeriodicTask[]
  budgets     Budget[]
  createdAt   DateTime  @default(now())
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  name        String?
  role        String
  password    String
  condominium Condominium? @relation(fields: [condominiumId], references: [id])
  condominiumId Int?
  createdAt   DateTime  @default(now())
}

model Call {
  id            Int       @id @default(autoincrement())
  type          String
  description   String
  status        String   @default("PENDENTE")
  responsible   String?
  telefone      String?
  bloco         String?
  apartamento   String?
  prioridade    String?
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  condominiumId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime?
  approvedAt    DateTime?
}

model PeriodicTask {
  id            Int       @id @default(autoincrement())
  serviceType   String
  description   String?
  lastExecDate  DateTime?
  nextDueDate   DateTime?
  status        String    @default("EM_DIA")
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  condominiumId Int
  createdAt     DateTime @default(now())
}

model Budget {
  id            Int       @id @default(autoincrement())
  providerName  String
  amount        Decimal?  @db.Decimal(12,2)
  status        String    @default("RECEBIDO")
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  condominiumId Int
  call          Call?     @relation(fields: [callId], references: [id])
  callId        Int?
  submittedAt   DateTime  @default(now())
  approvedAt    DateTime?
}


model FinancialRecord {
  id            Int       @id @default(autoincrement())
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  condominiumId Int
  type          String   // RECEITA ou DESPESA
  description   String
  amount        Decimal   @db.Decimal(12,2)
  date          DateTime
  createdAt     DateTime  @default(now())
}

model Reservation {
  id            Int       @id @default(autoincrement())
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  condominiumId Int
  space         String
  startTime     DateTime
  endTime       DateTime
  residentName  String
  createdAt     DateTime @default(now())
}

model Visitor {
  id            Int       @id @default(autoincrement())
  condominium   Condominium @relation(fields: [condominiumId], references: [id])
  condominiumId Int
  name          String
  document      String
  apartment     String
  entryTime     DateTime  @default(now())
  exitTime      DateTime?
}
